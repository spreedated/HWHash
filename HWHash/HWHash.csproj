<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Title>HwHash - HWInfo data to Dictionary</Title>
    <Authors>Dante Wackermann,DLain</Authors>
    <Description>HwHash is a library that grabs HWInfo sensor information and saves it to a Dictionary so it can be easily read.</Description>
    <RepositoryType>git</RepositoryType>
    <PackageTags>hwinfo,hardware,monitoring,sensors,metrics,system monitoring,hardware monitoring,shared memory,.net,windows,telemetry,performance,data collection,system info,hardware sensors,hwinfo integration</PackageTags>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <RepositoryUrl>https://github.com/layer07/HWHash</RepositoryUrl>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/spreedated/hwhash</PackageProjectUrl>
    <GenerateDocumentationFile Condition="'$(Configuration)'=='Release'">True</GenerateDocumentationFile>
    <VersionPrefix>2.0.0</VersionPrefix>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <GeneratePackageOnBuild Condition="'$(Configuration)'=='Release'">True</GeneratePackageOnBuild>
    <NoWarn>1701;1702;IDE0063;IDE0290</NoWarn>
    <RootNamespace>HwHash</RootNamespace>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>hwhash.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.6" />
  </ItemGroup>
  
<ItemGroup>
  <None Include="../LICENSE.txt" Pack="true" PackagePath="" />
  <None Include="../media/icon.png" Pack="true" PackagePath="" />
  <None Include="../readme.md" Pack="true" PackagePath="" />
</ItemGroup>

</Project>